# Copy to supabase/functions/.env for `supabase functions serve`.
# In the hosted project: supabase secrets set ALLOWED_ORIGIN=https://rowanflynnpilot.github.io
ALLOWED_ORIGIN=http://localhost:5173
# Cloudflare's test secret: accepts the test site key's dummy token. Production uses the real secret:
# supabase secrets set TURNSTILE_SECRET_KEY=<secret from the Turnstile widget>
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Email is off without RESEND_API_KEY; entries save either way. In the hosted project:
# supabase secrets set RESEND_API_KEY=re_... (and optionally EMAIL_FROM, EMAIL_REPLY_TO, STAFF_EMAILS, STAFF_QUEUE_URL).
# Locally, point RESEND_API_URL at a stand-in to see what would be sent without sending it.
# RESEND_API_KEY=re_local
# RESEND_API_URL=http://host.docker.internal:58499/emails
