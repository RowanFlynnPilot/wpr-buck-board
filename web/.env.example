# Copy to web/.env.local for `npm run dev`. In GitHub, set these as repository variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# The WordPress Brag Board page (one frame: the board, and the form at #enter; README "WordPress embed").
VITE_GALLERY_PAGE_URL=https://wausaupilotandreview.com/wausau-pilot-hunting-brag-board/
VITE_ENTER_PAGE_URL=https://wausaupilotandreview.com/wausau-pilot-hunting-brag-board/#enter
VITE_RULES_URL=https://wausaupilotandreview.com/wausau-pilot-hunting-brag-board/
# Cloudflare's test site key (always passes). Production: the Turnstile widget's site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
